# =============================================================================
# precompress / LightMem-standalone configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` in the project root, then edit the values:
#
#     cp .env.example .env
#
# `.env` is git-ignored. Real OS environment variables ALWAYS win over the
# file, so you can still override per-process: `OPENAI_MODEL=gpt-4o python ...`.
# =============================================================================


# -----------------------------------------------------------------------------
# OpenAI / OpenAI-compatible LLM
# -----------------------------------------------------------------------------

# REQUIRED for any real LLM extraction. Leave empty -> pipeline runs in
# compression-only mode (skip_llm=True).
OPENAI_API_KEY=

# Optional custom endpoint. Use this for self-hosted vLLM, SiliconFlow,
# DashScope, Together, etc. Leave empty -> https://api.openai.com/v1
OPENAI_BASE_URL=https://api.zhizengzeng.com/v1

# Chat model used for core-memory extraction.
# Known short-list (defines context_windows in OpenaiManager):
#   gpt-4o-mini  (128K)  qwen3-30b-a3b-instruct-2507 (128K)  glm-4.6 (200K)
# Any other model name works too - it will fall back to a 128K assumption.
OPENAI_MODEL=gpt-4o-mini

# Generation parameters (these mirror BaseMemoryManagerConfig defaults).
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
LLM_TOP_P=0.1


# -----------------------------------------------------------------------------
# OpenRouter (optional - set OPENROUTER_API_KEY to route through OpenRouter
# instead of direct OpenAI. When set, OPENAI_API_KEY/OPENAI_BASE_URL are
# ignored by OpenaiManager.)
# -----------------------------------------------------------------------------
# OPENROUTER_API_KEY=
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=
# OPENROUTER_APP_NAME=


# -----------------------------------------------------------------------------
# LLMLingua-2 pre-compression
# -----------------------------------------------------------------------------

# Model name. Two checkpoints are validated in LlmLingua2Config:
#   microsoft/llmlingua-2-bert-base-multilingual-cased-meetingbank   (~200 MB, default)
#   microsoft/llmlingua-2-xlm-roberta-large-meetingbank              (~2 GB)
# A local directory path also works.
LLMLINGUA_MODEL=microsoft/llmlingua-2-bert-base-multilingual-cased-meetingbank

# "cuda" if a GPU is available, otherwise "cpu". CPU works but is slow.
LLMLINGUA_DEVICE=cuda

# Set to false to use LLMLingua-1 algorithm instead of LLMLingua-2.
LLMLINGUA_USE_V2=true

# Compression rate: keep this fraction of tokens. Lower => more aggressive.
# Original LightMem default is 0.8; this standalone defaults to 0.5.
LLMLINGUA_RATE=0.5

# -1 disables target-token mode (use rate instead). Positive int = compress
# until output is approximately this many tokens.
LLMLINGUA_TARGET_TOKEN=-1

# Tuning knobs for LLMLingua-2 internals (rarely changed).
LLMLINGUA_MAX_BATCH_SIZE=50
LLMLINGUA_MAX_FORCE_TOKEN=100

# Optional instruction text prepended to the prompt during compression.
LLMLINGUA_INSTRUCTION=


# -----------------------------------------------------------------------------
# Concurrency
# -----------------------------------------------------------------------------

# Max parallel API calls inside `OpenaiManager._extract_with_prompt`.
# The original LightMem source hardcodes this to 5; this standalone reads it
# from the env so you can tune it. The effective worker count per extraction
# is `min(len(extract_list), EXTRACT_MAX_WORKERS)`.
# NOTE: event mode does two extractions (factual + relational), so the actual
# in-flight API calls can reach 2 * EXTRACT_MAX_WORKERS.
EXTRACT_MAX_WORKERS=5


# -----------------------------------------------------------------------------
# Test gating (only consumed by pytest in tests/conftest.py)
# -----------------------------------------------------------------------------

# Set to 1 to enable the real LLMLingua-2 model integration test.
# RUN_INTEGRATION=1
