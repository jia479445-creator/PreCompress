# Copy to `.env` and edit the values you actually need.

# LLM extraction
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
LLM_TOP_P=0.1

# LLMLingua-2 compression
LLMLINGUA_MODEL=/abs/path/to/PreCompress/models/llmlingua-2-bert
LLMLINGUA_DEVICE=cpu
LLMLINGUA_RATE=0.5

# Dataset
LONGMEMEVAL_DATA=/abs/path/to/longmemeval_s.json

# Optional
EXTRACT_MAX_WORKERS=5
